# Copy to .env. Generate a secret: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
APP_ENV=production
DATABASE_URL=sqlite:///budget.sqlite3
# Alternatives (URL-encode special characters in passwords):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/ua_budget
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/ua_budget?charset=utf8mb4
SESSION_COOKIE_SECURE=1
TRUST_PROXY=0
# Set TRUST_PROXY=1 only behind exactly ONE trusted reverse proxy.
MAX_UPLOAD_MB=8
# Stored outside public static files; use absolute, persistent paths in production.
# DATA_DIR=/var/lib/ua-budget-tracker
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=budget@example.com
# SMTP_TLS=1
